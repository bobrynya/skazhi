[Unit]
Description=skazhi ASR server (Vosk)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/skazhi
# optional overrides, e.g. SKAZHI_ADVERTISE_IP=192.168.1.10 (see README)
EnvironmentFile=-/etc/default/skazhi
ExecStart=/opt/skazhi/venv/bin/python /opt/skazhi/asr_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
