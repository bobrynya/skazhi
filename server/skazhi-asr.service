[Unit]
Description=skazhi ASR server (Vosk)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/skazhi
Environment=SKAZHI_MODEL=/opt/skazhi/model
ExecStart=/opt/skazhi/venv/bin/python /opt/skazhi/asr_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
